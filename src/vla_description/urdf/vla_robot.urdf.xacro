<?xml version="1.0"?>
<robot name="vla_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="dark_gray"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="cyan"><color rgba="0.0 0.7 0.8 1.0"/></material>
  <material name="orange"><color rgba="0.95 0.45 0.05 1.0"/></material>
  <material name="camera_blue"><color rgba="0.1 0.3 0.9 1.0"/></material>
  <material name="table_wood"><color rgba="0.8 0.7 0.55 1.0"/></material>

  <!-- World and Table -->
  <link name="world"/>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="table_link">
    <visual>
      <origin xyz="0.3 0 -0.025" rpy="0 0 0"/>
      <geometry><box size="1.2 1.2 0.05"/></geometry>
      <material name="table_wood"/>
    </visual>
  </link>

  <!-- Robot Base -->
  <joint name="table_to_base" type="fixed">
    <parent link="table_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.1"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <!-- Joint 1: Shoulder Pan -->
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415" upper="3.1415" effort="100" velocity="2.0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.15"/></geometry>
      <material name="cyan"/>
    </visual>
  </link>

  <!-- Joint 2: Shoulder Lift -->
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="100" velocity="2.0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.30"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- Joint 3: Elbow -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="80" velocity="2.5"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.25"/></geometry>
      <material name="cyan"/>
    </visual>
  </link>

  <!-- Joint 4: Wrist 1 Pitch -->
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="50" velocity="3.0"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.08"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- Joint 5: Wrist 2 Roll -->
  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415" upper="3.1415" effort="30" velocity="3.0"/>
  </joint>

  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <!-- Gripper Base & Fingers -->
  <joint name="tool_to_gripper" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.08 0.04 0.03"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0.02 0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.02" upper="0.02" effort="20" velocity="0.1"/>
  </joint>
  <link name="gripper_left_finger">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.008 0.02 0.05"/></geometry>
      <material name="cyan"/>
    </visual>
  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_right_finger"/>
    <origin xyz="-0.02 0 0.03" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.02" upper="0.02" effort="20" velocity="0.1"/>
  </joint>
  <link name="gripper_right_finger">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.008 0.02 0.05"/></geometry>
      <material name="cyan"/>
    </visual>
  </link>

  <link name="grasp_point"/>
  <joint name="gripper_to_grasp" type="fixed">
    <parent link="gripper_base"/>
    <child link="grasp_point"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <!-- Overhead RGB-D Perception Camera -->
  <link name="camera_stand">
    <visual>
      <origin xyz="0.45 0.5 0.35" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.7"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>
  <joint name="table_to_stand" type="fixed">
    <parent link="table_link"/>
    <child link="camera_stand"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.12 0.04"/></geometry>
      <material name="camera_blue"/>
    </visual>
  </link>
  <joint name="stand_to_camera" type="fixed">
    <parent link="camera_stand"/>
    <child link="camera_link"/>
    <origin xyz="0.45 0.45 0.70" rpy="0 0.9 -2.3"/>
  </joint>
</robot>
